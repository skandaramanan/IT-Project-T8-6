# Copy this file to .env and fill in the values. .env is gitignored.
# If you add a variable, add it here too, blank, in the
# same PR: this file is the only record of what configuration exists.

# Where the survey scans live on your machine. They are not in this repo; sync
# them from the shared Drive folder first (see README, "Data and secrets").
SURVEY_DATA_DIR=./data

# IT-37/IT-46 candidate: Azure Document Intelligence. Requires a custom model
# trained on this card layout (Azure portal/SDK, ~5 labeled samples) before it
# can return fields matching extraction.field_schema -- see
# spike/azure_doc_intel_extractor.py. Not read until all three are set.
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
AZURE_DOC_INTEL_MODEL_ID=
