# Copy this file to .env and fill in the values. .env is gitignored.
# If you add a variable, add it here too, blank, in the
# same PR: this file is the only record of what configuration exists.

# Where the survey scans live on your machine. They are not in this repo; sync
# them from the shared Drive folder first (see README, "Data and secrets").
SURVEY_DATA_DIR=./data

# The primary extraction engine (D012): Gemini via Google AI Studio,
# https://aistudio.google.com/apikey. The free tier covers Flash models with no
# billing account attached; Pro-class models left it on 2026-04-01, and the $300
# Google Cloud trial credit has excluded Gemini API usage since March 2026.
# See backend/survey/extraction/gemini.py.
#
# The daily request cap is per model, not per tier, and the gap decides the
# pipeline's shape: Flash is 20 requests/day/key, Flash-Lite is 500. Five team
# keys make that 100/day against 2,500/day. Check your live numbers at
# https://aistudio.google.com/rate-limit before planning a run.
# MODEL and MEDIA_RESOLUTION are optional overrides; the defaults are
# gemini-3.5-flash-lite and the model's own default resolution. For 3.x models,
# set GEMINI_MEDIA_RESOLUTION or you may be benchmarking a thumbnail.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MEDIA_RESOLUTION=

# Set to 1 to have Gemini self-report low/medium/high confidence per field
# (FR-10). Off by default: it is a different prompt, so it is a different
# experiment -- results file themselves under <model>-banded so the plain run
# stays comparable and IT-100 can report what asking for a band costs.
GEMINI_CONFIDENCE_BAND=

# Set to 1 to have Gemini also report which printed options were struck through
# (FR-06, D023). Off by default for the same reason as the band: a different
# prompt is a different experiment, filed under <model>-struck.
GEMINI_STRUCK_DETECTION=

# Where `survey extract` writes <region>.jsonl. Blank means ./results, the
# committed dataset (D025); point it elsewhere for a trial run you don't want
# showing up in git status.
SURVEY_OUTPUT_DIR=

# Local review (no Gemini key needed). Paths are configured per device.
# SCAN_ROOT contains region/PDF; DATA_CHECKOUT is a separate checkout on review-data.
# FLAGS is teammate-supplied JSONL; CACHE must be outside both code/data checkouts.
SURVEY_REVIEW_SCAN_ROOT=
SURVEY_REVIEW_DATA_CHECKOUT=
SURVEY_REVIEW_FLAGS=
SURVEY_REVIEW_CACHE=
# Blank means review-data, 180 seconds, and loopback port 8765 respectively.
SURVEY_REVIEW_DATA_BRANCH=
SURVEY_REVIEW_SYNC_INTERVAL=
SURVEY_REVIEW_PORT=
