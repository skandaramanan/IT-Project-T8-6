# Copy this file to .env and fill in the values. .env is gitignored.
# If you add a variable, add it here too, blank, in the
# same PR: this file is the only record of what configuration exists.

# Where the survey scans live on your machine. They are not in this repo; sync
# them from the shared Drive folder first (see README, "Data and secrets").
SURVEY_DATA_DIR=./data

# IT-37/IT-46 candidate: Azure Document Intelligence. Requires a custom model
# trained on this card layout (Azure portal/SDK, ~5 labeled samples) before it
# can return fields matching extraction.field_schema -- see
# spike/azure_doc_intel_extractor.py. Not read until all three are set.
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=
AZURE_DOC_INTEL_MODEL_ID=

# IT-37/IT-46 candidate: Ox Alpha via OpenRouter (stealth/ox-alpha). Key comes
# from the OpenRouter dashboard -- see spike/ox_alpha_extractor.py.
# Note: the free tier caps stealth models at 1,000 requests/day (resets 00:00
# UTC); it is a request cap, so --workers cannot stretch it.
OPENROUTER_API_KEY=

# IT-37/IT-46 candidate: Gemini via Google AI Studio (https://aistudio.google.com/apikey).
# The AI Studio free tier covers Flash models with no billing account attached;
# Pro-class models left it on 2026-04-01, and the $300 Google Cloud trial credit
# has excluded Gemini API usage since March 2026 -- see spike/gemini_extractor.py.
# MODEL and MEDIA_RESOLUTION are optional overrides; the defaults are
# gemini-3.6-flash and the model's own default resolution.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MEDIA_RESOLUTION=
